# Base URL of the fpledge FastAPI backend. Server Components fetch from here.
# Local dev falls back to http://127.0.0.1:8000 if unset (see src/lib/api.ts), but in any
# deployment where the API is NOT co-located you MUST set this to the public API URL, or
# every server-side fetch will hit localhost on the web host and fail.
#   Local:  NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
#   Prod:   NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
