# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Data (immutable raw + derived) — never commit; reconstructable from sources
data/
!data/.gitkeep

# MLflow experiment tracking
mlruns/
mlartifacts/

# Notebooks scratch
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# Design handoff bundles (prototypes / references, not source)
design_handoff_*/
build/
# Terraform: state maps config to live resource IDs and carries attributes — credential-adjacent,
# never committed. The .terraform dir is provider binaries. The LOCK FILE IS committed.
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfplan

# Secrets. ODDS_API_KEY and friends live in the environment (and in the Lambda config),
# never in the tree — this repo is public. See docs/OPERATIONS.md.
.env
.env.*
!.env.example
# Local credentials, in the project but never in the tree, the Lambda zips or the image.
# NOT inside fpledge/: build_lambda.sh rsyncs that whole directory into both deployment
# packages and rsync does not read this file.
.secrets/
